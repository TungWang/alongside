---
/**
 * 收費。同樣是「沒有資料時也要出現並說明原因」——
 * 家長點進來最想知道的兩件事就是收費和裁罰，兩者都不能只是默默不顯示。
 *
 * 分齡呈現，不給單一數字：2 歲與 5 歲的收費可以差三千以上，
 * 而本站對象是 0–3 歲家長，給一個混齡的平均反而讓他們低估預算。
 */
import data from '../data/institutions.json';
import { FEE_AGES } from '../lib/stats.js';
import { afterHoursFee, feeMonths } from '../lib/site.js';
import { isAffordableCare } from '../lib/subsidy.js';

const { inst, feeLink } = Astro.props;

const available = Boolean(data.archive && inst.kind === 'preschool');
const rows = available && inst.fees ? FEE_AGES.filter((a) => inst.fees[a]) : [];
const flatCap = ['非營利', '職場互助'].includes(inst.ownership);

// 「每月必繳」是全年攤平的平均，不是實際的付款節奏：學費、材料費這類項目是
// 開學一次繳，雜費、餐點費才是按月。一個照著平均值編預算的家長，開學那個月會短缺。
// 有分項的才顯示節奏——驗算不過的寧可不顯示，也不要給一個算錯的「開學要繳多少」。
const hasRhythm = rows.some((a) => inst.fees[a].registration !== undefined);
// 平價教保的家長每月繳費有政策上限，繳的是上限而不是園所申報的節奏
const capped = isAffordableCare(inst.ownership);
const afterHours = afterHoursFee(inst);
const months = feeMonths(inst);
---

<section class="stack">
  <h2>收費</h2>

  {
    rows.length > 0 ? (
      <>
        <div class="card">
          <div class="scroller">
            <table class="feetable">
              <thead>
                <tr>
                  <th>年齡</th>
                  {hasRhythm && <th class="num">開學繳</th>}
                  {hasRhythm && <th class="num">之後每月</th>}
                  <th class="num">平均每月</th>
                  <th class="num">全年</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((a) => (
                  <tr>
                    <td>{a} 歲</td>
                    {hasRhythm && (
                      <td class="num strong">
                        {inst.fees[a].registration === undefined
                          ? '—'
                          : inst.fees[a].registration.toLocaleString('en-US')}
                      </td>
                    )}
                    {hasRhythm && (
                      <td class="num strong">
                        {inst.fees[a].monthlyAfter === undefined
                          ? '—'
                          : inst.fees[a].monthlyAfter.toLocaleString('en-US')}
                      </td>
                    )}
                    <td class="num">{inst.fees[a].monthly.toLocaleString('en-US')}</td>
                    <td class="num">
                      {inst.fees[a].yearly ? inst.fees[a].yearly.toLocaleString('en-US') : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {hasRhythm && (
            <p class="rhythm-note">
              {capped
                ? `「開學繳」與「之後每月」是園所申報的收費節奏。但${inst.ownership}屬於平價教保，你實際繳的是政策上限那個數字（見下方試算），不是這裡的節奏。`
                : '學費、材料費這類項目是開學一次繳，雜費與餐點費才按月收。「平均每月」是把開學那筆攤平到全年的平均值——方便跟別間比較，但不是你實際的付款節奏。每學期開學都要繳一次。'}
            </p>
          )}
        </div>

        <dl class="extras">
          <div>
            <dt>課後延托費</dt>
            <dd>
              {afterHours ? `每月約 ${afterHours.toLocaleString('en-US')} 元（選繳）` : '這間沒有申報延托費用'}
            </dd>
          </div>
          <div>
            <dt>寒暑假</dt>
            <dd>
              {months == null
                ? '無資料'
                : months >= 12
                  ? `全年收費 ${months} 個月，寒暑假多半照常收托`
                  : `一年只收費 ${months} 個月，寒暑假通常另外安排或另外收費——要確定請直接問園所`}
            </dd>
          </div>
        </dl>

        <div class="state">
          <p>
            <strong>這些數字包含什麼、不包含什麼</strong>
          </p>
          <ul>
            <li>
              {'包含學費、雜費、材料費、活動費、午餐費、點心費——也就是園所申報的必繳項目。'}
            </li>
            <li>
              <strong>沒有扣掉任何政府補助。</strong>
              {'這是園所的收費，不是你實際要付的金額。準公共與公立有就學補助，實付會低不少，請以主管機關公告的補助標準為準。'}
            </li>
            <li>{'不含交通費與課後延托費，那些屬選繳項目，另列於上方。'}</li>
            <li>
              {'上下課的實際時間本站沒有——來源的收費明細表只區分半日班與全日班，沒有時刻。請直接問園所。'}
            </li>
            {flatCap && (
              <li>{`${inst.ownership}幼兒園的收費由政策訂定上限，同類型的園所數字多半一致，不是這間的個別結算。`}</li>
            )}
            <li>{'依園所申報的收費明細表推算，實際繳費仍請直接向園所確認。'}</li>
          </ul>
          {feeLink && (
            <p>
              官方收費規定見
              <a href={feeLink.url} target="_blank" rel="noopener nofollow">
                {feeLink.source} ↗
              </a>
              。
            </p>
          )}
        </div>
      </>
    ) : (
      <div class="state">
        <p>
          <strong>
            {inst.kind === 'preschool'
              ? '這間園所沒有收費資料。'
              : `本站沒有${inst.category}的收費資料。`}
          </strong>
        </p>
        <p>
          {inst.kind === 'preschool'
            ? '民間備份的資料裡查不到這間園申報的收費明細表，可能是尚未申報或格式無法解析。'
            : '幼兒園有依法申報的收費明細表可用，托嬰中心目前沒有任何結構化來源，本站無法整理。'}
        </p>
        {feeLink && (
          <p>
            收費規定請見
            <a href={feeLink.url} target="_blank" rel="noopener nofollow">
              {feeLink.source} ↗
            </a>
            ，實際金額直接向機構詢問最準。
          </p>
        )}
      </div>
    )
  }
</section>

<style>
  /* 五欄在窄螢幕會擠，讓表格自己橫向捲，不要讓整頁跟著歪 */
  .scroller {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .rhythm-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .feetable {
    width: 100%;
    min-width: 340px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .feetable th,
  .feetable td {
    text-align: left;
    padding: 9px 6px;
    border-bottom: 1px solid var(--line-soft);
  }
  .feetable th {
    font-size: 11.5px;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .feetable tr:last-child td {
    border-bottom: 0;
  }
  .feetable .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .feetable .strong {
    font-weight: 700;
    font-size: 15px;
  }

  .extras {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .extras > div {
    display: grid;
    grid-template-columns: 6.4em 1fr;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 14px;
  }
  .extras > div:last-child {
    border-bottom: 0;
  }
  .extras dt {
    color: var(--ink-soft);
    font-size: 13px;
    margin: 0;
  }
  .extras dd {
    margin: 0;
    line-height: 1.6;
  }

  .state {
    background: #f3ece0;
    border-radius: var(--radius-card);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--ink-soft);
  }
  .state p {
    margin: 0;
  }
  .state strong {
    color: var(--ink);
  }
  .state ul {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-left: 18px;
    list-style: disc;
  }
</style>
