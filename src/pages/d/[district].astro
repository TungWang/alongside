---
import Base from '../../layouts/Base.astro';
import InstitutionCard from '../../components/InstitutionCard.astro';
import BarChart from '../../components/BarChart.astro';
import DataNotice from '../../components/DataNotice.astro';
import data from '../../data/institutions.json';
import { SITE_NAME, tagColor, DATASETS, primaryFee } from '../../lib/site.js';
import { byOwnership } from '../../lib/stats.js';

export function getStaticPaths() {
  return data.districts.map((district) => ({
    params: { district },
    props: {
      district,
      list: data.institutions.filter((i) => i.district === district),
    },
  }));
}

const { district, list } = Astro.props;

const preschools = list.filter((i) => i.kind === 'preschool').length;
const nurseries = list.length - preschools;
const composition = byOwnership(list);

// 中位數固定用 2 歲：本站對象是 0–3 歲家長，而各齡價差可達三千以上，
// 混齡算出來的中位數兩邊都不代表。
const fees2 = list.map((i) => i.fees?.['2']?.monthly).filter(Boolean).sort((a, b) => a - b);
const feeMedian = fees2.length ? fees2[Math.floor(fees2.length / 2)] : null;
const penalised = list.filter((i) => i.penalties.length).length;
const feeCount = list.filter((i) => primaryFee(i)).length;
const accepts2 = list.filter((i) => i.ages?.includes(2)).length;

const noticeSources = [
  ...[...new Set(list.map((i) => i.category))].map((c) => ({
    label: DATASETS[c].label,
    agency: DATASETS[c].agency,
    url: DATASETS[c].url,
  })),
  ...(data.archive && preschools
    ? [{ label: data.archive.name, agency: `${data.archive.author}　原始出處：${data.archive.origin}`, url: data.archive.url }]
    : []),
];

// 篩選鈕只列這一區真的存在的屬性，避免家長按了得到空白
const ownerships = [...new Set(list.map((i) => i.ownership))];

const title = `${district}幼兒園與托嬰中心一覽（共 ${list.length} 間）｜${SITE_NAME}`;
const mix = [preschools && `幼兒園 ${preschools} 間`, nurseries && `托嬰中心 ${nurseries} 間`]
  .filter(Boolean)
  .join('、');
const description = `新北市${district}共 ${list.length} 間立案托育機構：${mix}。附地址、電話、Google 地圖，以及裁罰、評鑑、收退費與補助的官方查詢連結。`;
---

<Base title={title} description={description} path={`/d/${district}/`} back={{ href: '/', label: '所有行政區' }}>
  <div class="stack-lg">
    <section class="stack">
      <div class="stack-sm">
        <h1>新北市{district}</h1>
        <p class="muted">
          {
            preschools > 0 && nurseries > 0
              ? `共 ${list.length} 間立案托育機構——幼兒園 ${preschools} 間、托嬰中心 ${nurseries} 間。`
              : nurseries === 0
                ? `共 ${preschools} 間立案幼兒園。這一區目前沒有立案托嬰中心。`
                : `共 ${nurseries} 間立案托嬰中心。這一區目前沒有立案幼兒園。`
          }
        </p>
        {
          nurseries === 0 && (
            <p class="note">
              {'找不到不代表沒有——居家保母（居家托育）因為沒有完整的開放資料，不在本站收錄範圍，可洽'}<a
                href="https://lovebaby.sw.ntpc.gov.tw/"
                target="_blank"
                rel="noopener nofollow">新北育兒資訊網</a
              >{'或鄰近行政區的居家托育服務中心。'}
            </p>
          )
        }
      </div>

      {
        list.length >= 5 && (
          <details class="composition">
            <summary>
              這一區的組成
              {feeMedian ? `　·　2 歲月費中位數 ${feeMedian.toLocaleString('en-US')} 元` : ''}
            </summary>
            <div class="composition-body">
              <BarChart
                items={composition.map((c) => ({
                  label: c.ownership,
                  value: c.count,
                  color: tagColor(c.ownership),
                }))}
              />
              {penalised > 0 && (
                <p class="note">
                  {`其中 ${penalised} 間幼兒園在民間備份資料裡查得到裁罰紀錄。備份可能包含官方已下架的舊紀錄，詳見各機構頁的說明。`}
                </p>
              )}
              <a class="note" href="/概況/">看全市概況與資料來源說明 →</a>
            </div>
          </details>
        )
      }

      <div class="filterbar" role="group" aria-label="篩選機構">
        <button type="button" data-filter="all" aria-pressed="true">全部 {list.length}</button>
        {preschools > 0 && <button type="button" data-filter="kind:preschool" aria-pressed="false">幼兒園 {preschools}</button>}
        {nurseries > 0 && <button type="button" data-filter="kind:nursery" aria-pressed="false">托嬰中心 {nurseries}</button>}
        {
          ownerships.map((o) => (
            <button type="button" data-filter={`ownership:${o}`} aria-pressed="false">
              {o}
            </button>
          ))
        }
        {accepts2 > 0 && <button type="button" data-filter="age:2" aria-pressed="false">收 2 歲 {accepts2}</button>}
        {penalised > 0 && <button type="button" data-filter="flag:penalty" aria-pressed="false">有裁罰紀錄 {penalised}</button>}
      </div>

      <div class="listbar">
        <p class="note" id="result-count" aria-live="polite">共 {list.length} 間</p>
        {
          feeCount >= 3 && (
            <label class="sortpick">
              排序
              <select id="sort">
                <option value="name">機構名稱</option>
                <option value="fee-asc">費用：低到高</option>
                <option value="fee-desc">費用：高到低</option>
              </select>
            </label>
          )
        }
      </div>

      <ul class="stack" id="inst-list">
        {list.map((inst) => <InstitutionCard inst={inst} />)}
      </ul>

      <div class="card empty" id="no-match" hidden>
        <h3>這個條件下沒有機構</h3>
        <p>換一個條件看看，或回到全部。</p>
        <button class="btn" type="button" data-filter="all">看全部 {list.length} 間</button>
      </div>
    </section>

    <section class="stack-sm">
      <DataNotice sources={noticeSources} />
    </section>
  </div>
</Base>

<script>
  // 唯一的前端腳本：切換卡片顯示與重新排序，不需要伺服器。
  // 所有機構在 HTML 裡都已存在，關掉 JavaScript 仍看得到完整清單。
  const list = document.getElementById('inst-list');
  const counter = document.getElementById('result-count');
  const emptyState = document.getElementById('no-match');
  const sortPicker = document.getElementById('sort');
  const cards = [...list.querySelectorAll('.inst-card')];
  const buttons = [...document.querySelectorAll('.filterbar button')];

  // 保留原始順序（依名稱），切回「機構名稱」時才有依據
  cards.forEach((card, i) => (card.dataset.order = i));

  let activeFilter = 'all';

  function matches(card, filter) {
    const [field, value] = filter.split(':');
    if (field === 'all') return true;
    if (field === 'kind') return card.dataset.kind === value;
    if (field === 'ownership') return card.dataset.ownership === value;
    if (field === 'flag') return Number(card.dataset.penalties) > 0;
    if (field === 'age') return (card.dataset.ages || '').split('|').includes(value);
    return true;
  }

  function render() {
    let shown = 0;
    for (const card of cards) {
      const ok = matches(card, activeFilter);
      card.hidden = !ok;
      if (ok) shown++;
    }

    const mode = sortPicker ? sortPicker.value : 'name';
    if (mode !== 'name') {
      const dir = mode === 'fee-asc' ? 1 : -1;
      const sorted = [...cards].sort((a, b) => {
        const fa = Number(a.dataset.monthly);
        const fb = Number(b.dataset.monthly);
        // 沒有月費資料的一律排最後，不論升冪降冪——把它們混在中間會讓人誤以為是 0 元
        if (!fa && !fb) return a.dataset.order - b.dataset.order;
        if (!fa) return 1;
        if (!fb) return -1;
        return (fa - fb) * dir;
      });
      for (const card of sorted) list.appendChild(card);
    } else {
      for (const card of [...cards].sort((a, b) => a.dataset.order - b.dataset.order)) {
        list.appendChild(card);
      }
    }

    for (const btn of buttons) {
      btn.setAttribute('aria-pressed', String(btn.dataset.filter === activeFilter));
    }

    const label =
      mode === 'name' ? '依名稱排序'
      : mode === 'fee-asc' ? '依費用由低到高'
      : '依費用由高到低';
    counter.textContent = shown ? `${label}，共 ${shown} 間` : '';
    emptyState.hidden = shown > 0;
  }

  for (const el of document.querySelectorAll('[data-filter]')) {
    el.addEventListener('click', () => {
      activeFilter = el.dataset.filter;
      render();
    });
  }
  if (sortPicker) sortPicker.addEventListener('change', render);
  render();
</script>
