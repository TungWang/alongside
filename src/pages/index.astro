---
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import DataNotice from '../components/DataNotice.astro';
import data from '../data/institutions.json';
import { SITE_NAME, districtPath, tagColor, datasetsForCity, cityList } from '../lib/site.js';
import { byOwnership, chartableFees, ageCoverage } from '../lib/stats.js';

const allSources = [
  ...data.cities.flatMap((c) => datasetsForCity(c.name)),
  ...(data.archive
    ? [{ label: data.archive.name, agency: `${data.archive.author}　原始出處：${data.archive.origin}`, url: data.archive.url }]
    : []),
];
const owners = byOwnership();
const fees = chartableFees('2');
const ages = ageCoverage();
const accepts2 = ages[0].count;
const publicish = owners
  .filter((x) => ['公立', '非營利'].includes(x.ownership))
  .reduce((s, x) => s + x.count, 0);

const { institutions, districts, total, fetchedAt } = data;

const countByDistrict = Object.fromEntries(
  districts.map((d) => [d, institutions.filter((i) => i.district === d).length]),
);

// 家長找托育多半從自己那一區開始，所以按數量排——機構多的區先出現，
// 但仍保留完整 29 區，偏遠區不能因為只有兩三間就被藏起來。
const ordered = [...districts].sort((a, b) => countByDistrict[b] - countByDistrict[a]);

const preschools = institutions.filter((i) => i.kind === 'preschool').length;
const nurseries = total - preschools;

// 托嬰中心的資料落差很大：臺北市社會局公開評鑑與收托人數，新北市沒有。
// 這件事要照實講，而且要說明是資料落差不是機構差異，否則新北的家長會誤會。
const nurseryList = institutions.filter((i) => i.kind === 'nursery');
const homes = nurseryList.filter((i) => i.category === '社區公共托育家園').length;
const withEval = nurseryList.filter((i) => i.evaluations?.length).length;
const evalCities = [...new Set(nurseryList.filter((i) => i.evaluations?.length).map((i) => i.city))];
const noEvalCities = data.cities
  .map((c) => c.name)
  .filter((n) => !evalCities.includes(n) && nurseryList.some((i) => i.city === n));

const where = cityList(data.cities);
const title = `${where}幼兒園與托嬰中心一覽｜${SITE_NAME}`;
const description = `整理${where} ${data.districts.length} 個行政區共 ${total} 間立案幼兒園與托嬰中心的基本資料，並附上裁罰、評鑑、收退費與補助的官方查詢連結。資料來自政府開放平台。`;
---

<Base title={title} description={description} path="/">
  <div class="stack-lg">
    <section class="stack">
      <h1>一起看看<br />附近有哪些托育選擇</h1>
      <p class="muted">
        {`${where} ${total.toLocaleString('en-US')} 間立案幼兒園與托嬰中心。慢慢比較，不用急。`}
      </p>

      <svg
        viewBox="0 0 300 132"
        width="100%"
        style="max-width:420px"
        role="img"
        aria-label="插圖：大人牽著孩子走向一間小房子"
      >
        <g fill="none" stroke="#B08863" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 116H286"></path>
          <path d="M196 116V72l30-22 30 22v44"></path>
          <path d="M186 74l40-30 40 30"></path>
          <rect x="214" y="92" width="24" height="24" rx="3"></rect>
          <circle cx="226" cy="66" r="7"></circle>
          <circle cx="72" cy="46" r="12"></circle>
          <path d="M72 58v30m0 0l-12 28m12-28l12 28m-12-48l-24 10m24-10l26 14"></path>
          <circle cx="120" cy="72" r="8.5"></circle>
          <path d="M120 80.5V98m0 0l-8 18m8-18l8 18m-8-30l-16-4m16 4l13 6"></path>
        </g>
        <g fill="#EDE6DA">
          <circle cx="40" cy="30" r="5"></circle>
          <circle cx="268" cy="26" r="7"></circle>
          <circle cx="164" cy="22" r="4"></circle>
        </g>
      </svg>
    </section>

    <section class="stack">
      <div class="stack-sm">
        <h2>孩子多大了？</h2>
        <p class="note">
          {'不同年齡能上的機構不一樣，本站能提供的資料也差很多。先選年齡，我們直接說清楚哪一段幫得上忙、哪一段幫不上。'}
        </p>
      </div>

      <div class="agepick">
        <article class="agecard">
          <h3>未滿 2 歲</h3>
          <p class="agecard-sub">托嬰中心、托育家園或居家保母</p>
          <p class="agecard-body">
            {`這個年齡的選擇是托嬰中心、社區公共托育家園（${homes} 間，規模較小）或居家保母，本站收錄前兩者共 ${nurseries} 間。居家保母受個資法規範，沒有名冊可用。`}
          </p>
          <p class="agecard-body">
            {`${evalCities.join('、')}的社會局有公開評鑑結果與收托人數，所以那 ${withEval} 間看得到評鑑等第，部分還看得到目前還有沒有名額。`}
            {noEvalCities.length > 0 &&
              `${noEvalCities.join('、')}沒有公開這兩項，那裡只有名稱、地址、電話與核定人數——這是資料落差，跟機構好壞無關。`}
          </p>
          <p class="agecard-body">
            <strong>共同的限制：</strong>
            {'兩市都沒有托嬰中心的收費與裁罰的結構化資料，也都算不了距離（缺座標）。要問價格與過往紀錄，請用下面的官方查詢入口或直接打電話。'}
          </p>
          <div class="agecard-links">
            <a class="btn btn-quiet" href="/招生時程/">什麼時候要登記</a>
            <a class="btn btn-quiet" href="/搜尋/">找托嬰中心</a>
            <a class="btn btn-quiet" href="https://lovebaby.sw.ntpc.gov.tw/" target="_blank" rel="noopener nofollow">
              居家托育服務中心 ↗
            </a>
          </div>
        </article>

        <article class="agecard">
          <h3>2 歲以上</h3>
          <p class="agecard-sub">幼兒園幼幼班起</p>
          <p class="agecard-body">
            {`滿 2 歲就能上幼兒園的幼幼班。全市 ${preschools.toLocaleString('en-US')} 間幼兒園裡有 ${accepts2} 間收 2 歲，其餘 ${preschools - accepts2} 間要滿 3 歲。`}
          </p>
          <p class="agecard-body">
            <strong>這一段資料最完整。</strong>
            {'分齡收費、補助後你實際要付多少、裁罰紀錄、離你多遠、收不收 2 歲，都查得到。'}
          </p>
          <div class="agecard-links">
            <a class="btn" href="/附近/">找我附近的</a>
            <a class="btn btn-quiet" href="/招生時程/">什麼時候要登記</a>
          </div>
        </article>
      </div>
    </section>

    <section class="stack">
      <div class="stack-sm">
        <h2>想找哪一區？</h2>
        <p class="note">
          {`幼兒園 ${preschools.toLocaleString('en-US')} 間、托嬰中心 ${nurseries} 間，可在各區頁面再篩選。`}
        </p>
      </div>
      <div class="entry-actions">
        <a class="btn" href="/附近/">找我附近的幼兒園</a>
        <a class="btn btn-quiet" href="/搜尋/">已經知道名字？直接搜尋 →</a>
      </div>
      {
        data.cities.map((c) => (
          <div class="citygroup">
            <h3 class="cityname">
              {c.name}
              <span class="citymeta">
                {`幼兒園 ${c.preschools.toLocaleString('en-US')}　托嬰 ${c.nurseries}`}
              </span>
            </h3>
            <nav class="district-grid" aria-label={`${c.name}行政區`}>
              {[...c.districts]
                .sort((a, b) => countByDistrict[b] - countByDistrict[a])
                .map((d) => (
                  <a href={districtPath(d)}>
                    {d}
                    <span class="n">{countByDistrict[d]}</span>
                  </a>
                ))}
            </nav>
          </div>
        ))
      }
    </section>

    <section class="stack">
      <div class="stack-sm">
        <h2>先看全市的樣子</h2>
        <p class="note">
          {`兩市的幼兒園裡，公立與非營利加起來只有 ${publicish} 間，不到三分之一——這也是為什麼公立要抽籤。`}
        </p>
      </div>
      <div class="card">
        <BarChart
          items={owners.map((x) => ({ label: x.ownership, value: x.count, color: tagColor(x.ownership) }))}
          caption="各類型的機構數量。"
        />
      </div>
      {
        fees.length > 0 && (
          <div class="card">
            <BarChart
              items={fees.map((f) => ({
                label: f.ownership,
                value: f.median,
                display: `${f.median.toLocaleString('en-US')} 元`,
                color: tagColor(f.ownership),
              }))}
              caption="各類型幼兒園收 2 歲的每月必繳中位數，未扣政府補助。資料來源與注意事項見托育概況頁。"
            />
          </div>
        )
      }
      <a class="btn btn-quiet" href="/概況/" style="align-self:flex-start">
        看完整的托育概況 →
      </a>
    </section>

    <section class="card stack-sm">
      <h2>這個網站幫你做什麼</h2>
      <p class="note">
        {'找托育的資訊散在好幾個政府網站：立案名冊在開放資料平台、裁罰紀錄在全國教保資訊網或社會局、評鑑結果又是另一個頁面。這裡把每間機構的基本資料集中成一頁，並且直接給你四個官方查詢入口，少繞一點路。'}
      </p>
      <p class="note">
        {'評價與地圖都連到 Google 地圖，由你自己去看第一手的家長留言——本站不轉載、不評分、不排名。居家保母（居家托育）因為沒有完整的開放資料，不在收錄範圍。'}
      </p>
    </section>

    <section class="stack-sm">
      <DataNotice sources={allSources} />
    </section>
  </div>
</Base>
