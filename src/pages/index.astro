---
import Base from '../layouts/Base.astro';
import BarChart from '../components/BarChart.astro';
import DataNotice from '../components/DataNotice.astro';
import data from '../data/institutions.json';
import { SITE_NAME, districtPath, tagColor, DATASETS } from '../lib/site.js';
import { byOwnership, chartableFees } from '../lib/stats.js';

const allSources = [
  ...Object.values(DATASETS).map((d) => ({ label: d.label, agency: d.agency, url: d.url })),
  ...(data.archive
    ? [{ label: data.archive.name, agency: `${data.archive.author}　原始出處：${data.archive.origin}`, url: data.archive.url }]
    : []),
];
const owners = byOwnership();
const fees = chartableFees('2');
const publicish = owners
  .filter((x) => ['公立', '非營利'].includes(x.ownership))
  .reduce((s, x) => s + x.count, 0);

const { institutions, districts, total, fetchedAt } = data;

const countByDistrict = Object.fromEntries(
  districts.map((d) => [d, institutions.filter((i) => i.district === d).length]),
);

// 家長找托育多半從自己那一區開始，所以按數量排——機構多的區先出現，
// 但仍保留完整 29 區，偏遠區不能因為只有兩三間就被藏起來。
const ordered = [...districts].sort((a, b) => countByDistrict[b] - countByDistrict[a]);

const preschools = institutions.filter((i) => i.kind === 'preschool').length;
const nurseries = total - preschools;

const title = `新北市幼兒園與托嬰中心一覽｜${SITE_NAME}`;
const description = `整理新北市 29 個行政區共 ${total} 間立案幼兒園與托嬰中心的基本資料，並附上裁罰、評鑑、收退費與補助的官方查詢連結。資料來自政府開放平台。`;
---

<Base title={title} description={description} path="/">
  <div class="stack-lg">
    <section class="stack">
      <h1>一起看看<br />附近有哪些托育選擇</h1>
      <p class="muted">
        新北市 {total.toLocaleString('en-US')} 間立案幼兒園與托嬰中心，資料來自政府開放平台。慢慢比較，不用急。
      </p>

      <svg
        viewBox="0 0 300 132"
        width="100%"
        style="max-width:420px"
        role="img"
        aria-label="插圖：大人牽著孩子走向一間小房子"
      >
        <g fill="none" stroke="#B08863" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 116H286"></path>
          <path d="M196 116V72l30-22 30 22v44"></path>
          <path d="M186 74l40-30 40 30"></path>
          <rect x="214" y="92" width="24" height="24" rx="3"></rect>
          <circle cx="226" cy="66" r="7"></circle>
          <circle cx="72" cy="46" r="12"></circle>
          <path d="M72 58v30m0 0l-12 28m12-28l12 28m-12-48l-24 10m24-10l26 14"></path>
          <circle cx="120" cy="72" r="8.5"></circle>
          <path d="M120 80.5V98m0 0l-8 18m8-18l8 18m-8-30l-16-4m16 4l13 6"></path>
        </g>
        <g fill="#EDE6DA">
          <circle cx="40" cy="30" r="5"></circle>
          <circle cx="268" cy="26" r="7"></circle>
          <circle cx="164" cy="22" r="4"></circle>
        </g>
      </svg>
    </section>

    <section class="stack">
      <div class="stack-sm">
        <h2>想找哪一區？</h2>
        <p class="note">
          幼兒園 {preschools.toLocaleString('en-US')} 間、托嬰中心 {nurseries} 間，可在各區頁面再篩選。
        </p>
      </div>
      <div class="entry-actions">
        <a class="btn" href="/附近/">找我附近的幼兒園</a>
        <a class="btn btn-quiet" href="/搜尋/">已經知道名字？直接搜尋 →</a>
      </div>
      <nav class="district-grid" aria-label="行政區">
        {
          ordered.map((d) => (
            <a href={districtPath(d)}>
              {d}
              <span class="n">{countByDistrict[d]}</span>
            </a>
          ))
        }
      </nav>
    </section>

    <section class="stack">
      <div class="stack-sm">
        <h2>先看全市的樣子</h2>
        <p class="note">
          {`新北市的幼兒園裡，公立與非營利加起來只有 ${publicish} 間，不到三分之一——這也是為什麼公立要抽籤。`}
        </p>
      </div>
      <div class="card">
        <BarChart
          items={owners.map((x) => ({ label: x.ownership, value: x.count, color: tagColor(x.ownership) }))}
          caption="各類型的機構數量。"
        />
      </div>
      {
        fees.length > 0 && (
          <div class="card">
            <BarChart
              items={fees.map((f) => ({
                label: f.ownership,
                value: f.median,
                display: `${f.median.toLocaleString('en-US')} 元`,
                color: tagColor(f.ownership),
              }))}
              caption="各類型幼兒園收 2 歲的每月必繳中位數，未扣政府補助。資料來源與注意事項見托育概況頁。"
            />
          </div>
        )
      }
      <a class="btn btn-quiet" href="/概況/" style="align-self:flex-start">
        看完整的新北市托育概況 →
      </a>
    </section>

    <section class="card stack-sm">
      <h2>這個網站幫你做什麼</h2>
      <p class="note">
        {'找托育的資訊散在好幾個政府網站：立案名冊在開放資料平台、裁罰紀錄在全國教保資訊網或社會局、評鑑結果又是另一個頁面。這裡把每間機構的基本資料集中成一頁，並且直接給你四個官方查詢入口，少繞一點路。'}
      </p>
      <p class="note">
        {'評價與地圖都連到 Google 地圖，由你自己去看第一手的家長留言——本站不轉載、不評分、不排名。居家保母（居家托育）因為沒有完整的開放資料，不在收錄範圍。'}
      </p>
    </section>

    <section class="stack-sm">
      <DataNotice sources={allSources} />
    </section>
  </div>
</Base>
