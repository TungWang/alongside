---
import Base from '../../layouts/Base.astro';
import OverviewBlock from '../../components/OverviewBlock.astro';
import PenaltyList from '../../components/PenaltyList.astro';
import FeeBlock from '../../components/FeeBlock.astro';
import SubsidyBlock from '../../components/SubsidyBlock.astro';
import DataNotice from '../../components/DataNotice.astro';
import data from '../../data/institutions.json';
import {
  SITE_NAME,
  tagColor,
  officialLinks,
  districtPath,
  fullType,
  needsCategoryTag,
  datasetFor,
  linkOfKind,
  primaryFee,
  feeMonths,
  afterHoursFee,
} from '../../lib/site.js';

export function getStaticPaths() {
  return data.institutions.map((inst) => ({
    params: { id: inst.id },
    props: { inst },
  }));
}

const { inst } = Astro.props;
const links = officialLinks(inst.city, inst.authority);
const needsName = links.some((l) => l.needsName);

const cityShort = inst.city.replace(/[市巿]$/, '市');
const authorityName = `${cityShort}政府${inst.authority === 'edu' ? '教育局' : '社會局'}`;

// 月費與裁罰來自民間封存，只有幼兒園有；archive 為 null 表示本次建置未採用該來源
const enriched = data.archive && inst.kind === 'preschool';
const penaltyLink = linkOfKind(links, 'penalty');
const feeLink = linkOfKind(links, 'fee');

const fee = primaryFee(inst);
const saved = {
  id: inst.id,
  name: inst.name,
  district: inst.district,
  ownership: inst.ownership,
  ages: inst.ages || [],
  fee: fee?.monthly || null,
  feeAge: fee?.age || null,
  afterHours: afterHoursFee(inst),
  months: feeMonths(inst),
  penalties: inst.penalties.length,
};

const dataset = datasetFor(inst.city, inst.category);
const noticeSources = [
  { label: dataset.label, agency: dataset.agency, url: dataset.url },
  ...(enriched
    ? [
        {
          label: data.archive.name,
          agency: `${data.archive.author}　原始出處：${data.archive.origin}　備份於 ${data.archive.updatedAt}`,
          url: data.archive.url,
        },
      ]
    : []),
  { label: `${penaltyLink.source}：即時查詢`, agency: '裁罰與評鑑以此為準', url: penaltyLink.url },
];

const title = `${inst.name}｜${inst.city}${inst.district}${inst.category}－${SITE_NAME}`;
const description = `${inst.name}位於${inst.city}${inst.district}${inst.street}，電話 ${inst.tel}，屬性為${inst.ownership}。附 Google 地圖連結，以及裁罰紀錄、評鑑結果、收退費與育兒補助的官方查詢入口。`;

// 結構化資料讓 Google 認得這是一間托育機構，而不只是一頁文字
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ChildCare',
  name: inst.name,
  telephone: inst.tel,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'TW',
    addressRegion: inst.city,
    addressLocality: inst.district,
    streetAddress: inst.street,
  },
  ...(inst.operator ? { parentOrganization: { '@type': 'Organization', name: inst.operator } } : {}),
};
---

<Base
  title={title}
  description={description}
  path={`/i/${inst.id}/`}
  back={{ href: districtPath(inst.district), label: inst.district }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="stack-lg">
    <section class="stack">
      <div class="stack-sm">
        <div class="tagrow">
          <span class="tag" style={`background:${tagColor(inst.ownership)}`}>{inst.ownership}</span>
          {needsCategoryTag(inst) && <span class="tag tag-outline">{inst.category}</span>}
        </div>
        <h1>{inst.name}</h1>
        <p class="muted">{inst.city}{inst.district}　主管機關：{authorityName}</p>
      </div>

      <OverviewBlock inst={inst} enriched={enriched} />

      <div class="head-actions">
        <a class="btn" href={inst.mapUrl} target="_blank" rel="noopener nofollow">
          在 Google 地圖查看與看評價 ↗
        </a>
        <button class="savebtn save-toggle" type="button" data-entry={JSON.stringify(saved)}>收藏</button>
      </div>
      <p class="note">
        {'本站不轉載星等與評論，點上面的連結會開啟 Google 地圖，由你直接看其他家長的第一手留言。'}
      </p>
    </section>

    <section class="card">
      <dl class="deflist">
        <div>
          <dt>地址</dt>
          <dd>{inst.address}</dd>
        </div>
        <div>
          <dt>電話</dt>
          <dd><a href={`tel:${inst.telHref}`}>{inst.tel}</a></dd>
        </div>
        <div>
          <dt>屬性</dt>
          <dd>{fullType(inst)}</dd>
        </div>
        {
          inst.capacity && (
            <div>
              <dt>核定收托</dt>
              <dd>{inst.capacity} 人</dd>
            </div>
          )
        }
        {
          inst.operator && (
            <div>
              <dt>受託單位</dt>
              <dd>{inst.operator}</dd>
            </div>
          )
        }
        {
          enriched && inst.ages?.length > 0 && (
            <div>
              <dt>收托年齡</dt>
              <dd>{Math.min(...inst.ages)} 至 {Math.max(...inst.ages)} 歲</dd>
            </div>
          )
        }
        {
          enriched && inst.approvedCount && (
            <div>
              <dt>核定招收</dt>
              <dd>{inst.approvedCount} 人</dd>
            </div>
          )
        }
        {
          enriched && inst.floorArea && (
            <div>
              <dt>室內面積</dt>
              <dd>{inst.floorArea}</dd>
            </div>
          )
        }
        {
          enriched && inst.floorAreaOut && (
            <div>
              <dt>戶外空間</dt>
              <dd>{inst.floorAreaOut}</dd>
            </div>
          )
        }
        {
          enriched && inst.regNo && (
            <div>
              <dt>立案字號</dt>
              <dd class="regno">{inst.regNo}</dd>
            </div>
          )
        }
        {
          enriched && inst.website && (
            <div>
              <dt>園所網站</dt>
              <dd>
                <a href={inst.website} target="_blank" rel="noopener nofollow">
                  {inst.website.replace(/^https?:\/\//, '').slice(0, 34)} ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      {
        enriched && (inst.fees || inst.regNo) && (
          <p class="source">
            收費、立案字號、核定人數與面積來自<a
              href={data.archive.url}
              target="_blank"
              rel="noopener nofollow">{data.archive.name} ↗</a
            >{`（${data.archive.author}，${data.archive.license} 授權），原始出處為${data.archive.origin}，該備份更新於 ${data.archive.updatedAt}。`}
          </p>
        )
      }
    </section>

    <FeeBlock inst={inst} feeLink={feeLink} />

    {enriched && <SubsidyBlock inst={inst} />}

    <PenaltyList
      penalties={inst.penalties}
      available={enriched}
      kindLabel={inst.category}
      officialUrl={penaltyLink?.url}
      officialLabel={penaltyLink?.source}
    />

    <section class="stack">
      <div class="stack-sm">
        <h2>想再確認什麼，這裡直接查</h2>
        <p class="note">
          {'以下都是主管機關的官方查詢頁，資料以那邊為準。本站不自行收錄裁罰與評鑑紀錄，因為那些資料會隨時效下架、格式也不一，轉載反而容易誤導。'}
        </p>
      </div>

      {
        needsName && (
          <div class="copybar">
            <span class="note">官方查詢頁沒辦法用網址帶入機構名稱，先複製起來再貼過去比較快。</span>
            <button type="button" id="copy-name" data-name={inst.name}>
              複製「{inst.name}」
            </button>
          </div>
        )
      }

      <div class="stack-sm">
        {
          links.map((link) => (
            <a class="linkrow" href={link.url} target="_blank" rel="noopener nofollow">
              <span>{link.label}</span>
              <span class="src">
                {link.source} ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="stack-sm">
      <DataNotice sources={noticeSources} />
    </section>
  </div>
</Base>

<script>
  const button = document.getElementById('copy-name');
  if (button) {
    const original = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.name);
        button.textContent = '已複製，貼到官方查詢頁就行';
      } catch {
        button.textContent = '複製失敗，請長按上方名稱手動複製';
      }
      setTimeout(() => (button.textContent = original), 2600);
    });
  }
</script>
