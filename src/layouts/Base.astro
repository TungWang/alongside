---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, GSC_VERIFICATION, cityList } from '../lib/site.js';
import data from '../data/institutions.json';

const { title, description, path = '/', back = null } = Astro.props;
const canonical = new URL(path, SITE_URL).href;

// 沒有市府開放資料的縣市，幼兒園完全依賴民間封存。這個韌性差異要對讀者說明白。
const archiveOnly = data.cities.filter((c) => c.preschoolBackbone === 'archive').map((c) => c.name);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#F7F3EC" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23B08863'/%3E%3Cpath d='M7 18a4.5 4.5 0 0 1 9 0 4.5 4.5 0 0 1 9 0l-9 9z' fill='%23FFFDF9'/%3E%3C/svg%3E"
    />
    <slot name="head" />
  </head>
  <body>
    {/* 內容由 staleness.js 在瀏覽器端填入——建置期算不出「建置沒有在跑」這件事 */}
    <div id="stale-banner" class="stale-banner" data-fetched={data.fetchedAt} role="status" hidden>
    </div>

    <header class="shell">
      <div class="masthead">
        <a class="brandmark" href="/">
          <span class="glyph" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 12 12">
              <path d="M2 6.5A2 2 0 0 1 6 6.5 2 2 0 0 1 10 6.5L6 10.5z" fill="#FFFDF9"></path>
            </svg>
          </span>
          {SITE_NAME}
        </a>
        <span class="head-right">
          <a class="crumb" href="/收藏/">
            收藏<span class="countbadge" id="shortlist-count" hidden></span>
          </a>
          {
            back ? (
              <a class="crumb" href={back.href}>
                ← {back.label}
              </a>
            ) : (
              <span class="tag tag-outline">{cityList(data.cities, '·')}</span>
            )
          }
        </span>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="sitefoot">
      <div class="shell stack-sm">
        <p>
          <strong style="color:var(--ink)">{SITE_NAME} Alongside</strong>　{`陪你一起看看${cityList(data.cities)}有哪些托育選擇。`}
        </p>
        <p>
          {`站上資料為程式自動整理，可能有誤或未及反映異動——請以官方公告與機構本身的說明為準。機構基本資料擷取時間 ${data.fetchedAt}`}<span
            id="data-age"
            class="age-badge"
            hidden></span>{`，共 ${data.total.toLocaleString('en-US')} 間。`}
        </p>
        {
          data.archive && (
            <p>
              {`幼兒園的收費、立案字號與裁罰紀錄來自${data.archive.name}（${data.archive.author}，${data.archive.license} 授權，原始出處為${data.archive.origin}，備份於 ${data.archive.updatedAt}）。該備份可能包含官方已下架的舊紀錄，托嬰中心則無對應資料。`}
              {archiveOnly.length > 0 &&
                `${archiveOnly.join('、')}的幼兒園名冊本身也只有這個來源——該市沒有市府層級的幼兒園開放資料。`}
            </p>
          )
        }
        <p>
          本站僅整理公開資訊與提供官方查詢入口，不對機構品質作任何評價、排名或背書。
        </p>
        <p class="footlinks">
          <a href="/招生時程/">招生時程</a>
          <a href="/收藏/">我的收藏</a>
          <a href="/附近/">找我附近的</a>
          <a href="/搜尋/">搜尋機構</a>
          <a href="/裁罰/">裁罰紀錄一覽</a>
          <a href="/概況/">托育概況</a>
          <a href="/授權/">資料來源與授權聲明</a>
        </p>
      </div>
    </footer>
    <script>
      import { mountCounter, toggle, has } from '../scripts/shortlist.js';
      import { mount as mountStaleness } from '../scripts/staleness.js';
      mountCounter();
      mountStaleness();

      // 收藏鈕在列表卡與機構頁都會出現，統一在這裡接
      function paint(btn) {
        const on = has(JSON.parse(btn.dataset.entry).id);
        btn.setAttribute('aria-pressed', String(on));
        btn.textContent = on ? '已收藏' : '收藏';
      }
      for (const btn of document.querySelectorAll('.save-toggle')) {
        paint(btn);
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggle(JSON.parse(btn.dataset.entry));
          paint(btn);
        });
      }
    </script>
  </body>
</html>
